<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Formato A4 con margine superiore maggiorato, dedicato ai report
             del Registro Interventi: il margine di default (52mm) non basta
             quando l'intestazione della company è alta (logo + nome + più
             righe di indirizzo + P.IVA), perché wkhtmltopdf riserva
             un'altezza fissa per l'intestazione, non adattata al contenuto
             effettivo - se l'intestazione reale è più alta del margine
             configurato, sconfina visivamente sul corpo del documento. -->
        <record id="paperformat_intervento" model="report.paperformat">
            <field name="name">A4 Intervento (intestazione maggiorata)</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">75</field>
            <field name="margin_bottom">32</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">75</field>
            <field name="dpi">90</field>
        </record>

    </data>
</odoo>
