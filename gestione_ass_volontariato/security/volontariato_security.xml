<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Ruolo base: accesso operativo limitato (turni in sola consultazione,
         nessun accesso a dati sanitari degli interventi, dispositivi/contratti,
         contabilità, prestito presidi e configurazione) -->
    <record id="group_volontariato_volontario" model="res.groups">
        <field name="name">Volontariato / Volontario</field>
        <field name="comment">Accesso limitato per i volontari operativi: Gestione Turni (sola
consultazione) e Calendario. Nessun accesso a Servizi (Registro Interventi,
Richieste di Assistenza, Registro Esercitazioni - contengono dati sanitari),
Dispositivi e Contratti, Contabilità, Prestito Presidi e Configurazione.</field>
    </record>

    <!-- Ruolo esteso: accesso completo a tutte le aree del modulo.
         L'amministratore principale viene aggiunto automaticamente; gli altri
         referenti/coordinatori vanno assegnati manualmente da Impostazioni > Utenti. -->
    <record id="group_volontariato_responsabile" model="res.groups">
        <field name="name">Volontariato / Responsabile</field>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Accesso completo al modulo Volontariato: Servizi, Dispositivi e
Contratti, Contabilità, Prestito Presidi e Configurazione, oltre a tutto
quanto già visibile a tutti gli utenti interni (Gestione Turni, Automezzi,
Volontari, Dashboard).</field>
    </record>

    <!-- Il menù "Applicazioni" nativo di Odoo dovrebbe essere di serie
         riservato agli Amministratori (groups="base.group_system"), ma su
         questo database la restrizione risultava rimossa, rendendolo
         visibile a qualunque utente interno, incluso il ruolo Volontario.
         La ripristiniamo esplicitamente. -->
    <menuitem id="base.menu_management" groups="base.group_system"/>

    <!-- Il Responsabile può modificare (solo write, non creare/eliminare)
         le sole numerazioni (ir.sequence) introdotte da questo modulo,
         per correggere buchi di numerazione senza poter toccare le
         sequenze di altri moduli (es. fatturazione). -->
    <record id="ir_sequence_rule_volontariato_responsabile" model="ir.rule">
        <field name="name">Sequenze Volontariato: solo le sequenze del modulo</field>
        <field name="model_id" ref="base.model_ir_sequence"/>
        <field name="groups" eval="[(4, ref('group_volontariato_responsabile'))]"/>
        <field name="domain_force">[('code', 'in', ['volontariato.intervento', 'volontariato.esercitazione', 'volontariato.turno', 'volontariato.richiesta.assistenza'])]</field>
        <field name="perm_read">0</field>
        <field name="perm_write">1</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
