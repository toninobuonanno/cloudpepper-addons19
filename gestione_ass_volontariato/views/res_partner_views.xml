<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Sposta il campo Azienda (company_id) dalla scheda "Vendite e
         acquisti" > Varie alla parte alta della form, dopo Sito web: con
         la separazione multi-company tra le sedi è un campo da
         valorizzare spesso (es. sui richiedenti/donatori), quindi conviene
         averlo subito visibile invece che dentro una scheda secondaria.
         Ancorato a "website" e non a "vat" perché il modulo base_vat
         avvolge quest'ultimo in un div insieme al controllo VIES, dove un
         campo inserito "after" perde l'etichetta automatica. -->
    <record id="view_partner_form_company_id_in_evidenza" model="ir.ui.view">
        <field name="name">res.partner.form.company.id.in.evidenza</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='website']" position="after">
                <xpath expr="//group[@name='misc']/field[@name='company_id'][@groups='base.group_multi_company']" position="move"/>
            </xpath>
        </field>
    </record>

</odoo>
