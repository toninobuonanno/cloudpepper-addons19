<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_certificazione_volontario_list" model="ir.ui.view">
        <field name="name">volontariato.certificazione.volontario.list</field>
        <field name="model">volontariato.certificazione.volontario</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="employee_id" string="Volontario"/>
                <field name="tipo_cert_id"/>
                <field name="data_conseguimento"/>
                <field name="data_scadenza"/>
                <field name="stato_scadenza" widget="badge"/>
                <field name="certificato_filename" column_invisible="1"/>
                <field name="certificato_file" widget="binary" filename="certificato_filename"
                       string="Allegato" invisible="certificato_file" nolabel="1"/>
                <button name="action_download_certificato" type="object" string="Visualizza"
                        icon="fa-eye" invisible="not certificato_file"/>
            </list>
        </field>
    </record>

    <record id="view_certificazione_volontario_form" model="ir.ui.view">
        <field name="name">volontariato.certificazione.volontario.form</field>
        <field name="model">volontariato.certificazione.volontario</field>
        <field name="arch" type="xml">
            <form string="Certificazione Volontario">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="tipo_cert_id"/>
                        </group>
                        <group>
                            <field name="data_conseguimento"/>
                            <field name="data_scadenza"/>
                            <field name="stato_scadenza" widget="badge"/>
                        </group>
                    </group>
                    <group string="Allegato">
                        <field name="certificato_filename" invisible="1"/>
                        <field name="certificato_file" widget="binary"
                               filename="certificato_filename" string="Certificato"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_certificazione_volontario_search" model="ir.ui.view">
        <field name="name">volontariato.certificazione.volontario.search</field>
        <field name="model">volontariato.certificazione.volontario</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="tipo_cert_id"/>
                <filter string="Scadute" name="cert_expired" domain="[('stato_scadenza', '=', 'expired')]"/>
                <filter string="In Scadenza" name="cert_warn" domain="[('stato_scadenza', '=', 'warn')]"/>
                <filter string="Valide" name="cert_ok" domain="[('stato_scadenza', '=', 'ok')]"/>
            </search>
        </field>
    </record>

    <record id="action_volontariato_certificazione_volontario_global" model="ir.actions.act_window">
        <field name="name">Certificazioni Volontari</field>
        <field name="res_model">volontariato.certificazione.volontario</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_certificazione_volontario_list"/>
    </record>

</odoo>
